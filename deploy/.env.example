# Copy to deploy/.env. Read by `docker compose -f deploy/docker-compose.yml ...` (and switch.sh).
# Secrets (Alpaca keys, tokens) stay in config/alpaca.env and config/trader.env, not here.

# --- who owns ./data on the host (the containers run as this uid/gid) -----------------------
# switch.sh fills these in from `id -u` / `id -g` when they are missing.
TRADER_UID=1000
TRADER_GID=1000

# --- web ------------------------------------------------------------------------------------
# Host interface/port the dashboard is published on (no Traefik). 127.0.0.1 = this machine only.
# For a phone over Tailscale use the machine's tailnet IP (tailscale ip -4), never 0.0.0.0.
WEB_BIND=127.0.0.1
WEB_PORT=8010
# What the PHONE opens; ntfy Approve/Reject buttons are built from it. With Traefik:
# https://<TRADER_HOST>. Leave unset to use WEB_URL from config/trader.env.
#WEB_URL=https://trader.your-tailnet.ts.net
# user:password in front of the whole web app (on top of WEB_TOKEN). Leave unset to use trader.env.
#WEB_BASIC_AUTH=

# --- Ollama / LLM (no Claude CLI in the image) ---------------------------------------------
LLM_BACKEND=ollama
# Ollama running on the Docker host (extra_hosts maps host.docker.internal for you):
OLLAMA_FALLBACK_URL=http://host.docker.internal:11434
# The primary (OLLAMA_URL, e.g. the GPU box over Tailscale) is read from config/trader.env.

# --- paths (defaults are relative to deploy/) -----------------------------------------------
#DATA_DIR=../data
#LIMITS_FILE=../config/limits.json
#ALPACA_ENV_FILE=../config/alpaca.env
#TRADER_ENV_FILE=../config/trader.env
#COMPOSE_PROJECT_NAME=thesis

# --- Traefik overlay (docker-compose.traefik.yml) -------------------------------------------
# Hostname Traefik routes to the dashboard; must resolve to the server on your tailnet.
TRADER_HOST=trader.example.ts.net
# Name of the external Docker network Traefik is attached to (docker network ls).
TRAEFIK_NETWORK=traefik
# Traefik entrypoint name for the router, e.g. websecure (443) or web (80).
TRAEFIK_ENTRYPOINT=websecure
# true for a TLS router (websecure); false for a plain-http entrypoint.
TRAEFIK_TLS=true
# Name of your certresolver (e.g. letsencrypt). Only used if you uncomment the certresolver
# label in docker-compose.traefik.yml; leave it commented if you supply certs another way.
TRAEFIK_CERTRESOLVER=
