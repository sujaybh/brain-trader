[Unit]
Description=Thesis Trader broker daemon (only process holding Alpaca keys; localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thesis
Group=thesis
WorkingDirectory=/home/anomander/RandomProject/server-stuff/tracker
# Alpaca keys: readable only by the thesis user (chmod 600). Non-secret settings (BROKER_HOST
# must stay 127.0.0.1) come from the project's config/trader.env.
EnvironmentFile=/etc/thesis-trader/alpaca.env
EnvironmentFile=-/home/anomander/RandomProject/server-stuff/tracker/config/trader.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/anomander/RandomProject/server-stuff/tracker/.venv/bin/python -m broker
Restart=always
RestartSec=5
# data/ is shared with anomander through the thesis group: keep new files group-writable.
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/anomander/RandomProject/server-stuff/tracker/data

[Install]
WantedBy=multi-user.target
