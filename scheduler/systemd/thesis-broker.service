[Unit]
Description=Thesis Trader broker daemon (only process holding Alpaca keys; localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thesis
Group=thesis
WorkingDirectory=__ROOT__
# Alpaca keys: readable only by the thesis user (chmod 600). Non-secret settings (BROKER_HOST
# must stay 127.0.0.1) come from the project's config/trader.env.
EnvironmentFile=/etc/thesis-trader/alpaca.env
EnvironmentFile=-__ROOT__/config/trader.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__ROOT__/.venv/bin/python -m broker
# Type=simple counts as started at fork; this makes the unit `active` only once GET /health
# answers, so units ordered After= it never race the listener at boot. A timeout fails the
# start and Restart= tries again.
ExecStartPost=__ROOT__/.venv/bin/python __ROOT__/scheduler/wait_broker.py --timeout 60
TimeoutStartSec=90
Restart=always
RestartSec=5
# data/ is shared with anomander through the thesis group: keep new files group-writable.
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__ROOT__/data

[Install]
WantedBy=multi-user.target
