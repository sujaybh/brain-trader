[Unit]
Description=Thesis Trader scheduler tick (run due DCA slots)
After=thesis-broker.service
Wants=thesis-broker.service

[Service]
Type=oneshot
User=anomander
SupplementaryGroups=thesis
UMask=0002
WorkingDirectory=__ROOT__
EnvironmentFile=-__ROOT__/config/trader.env
ExecStart=__ROOT__/.venv/bin/python __ROOT__/scheduler/tick.py
TimeoutStartSec=10min
