[Unit]
Description=Thesis Trader nightly: reconcile, snapshot, news, triggers
After=thesis-broker.service
Wants=thesis-broker.service

[Service]
Type=oneshot
User=anomander
SupplementaryGroups=thesis
UMask=0002
WorkingDirectory=/home/anomander/RandomProject/server-stuff/tracker
EnvironmentFile=-/home/anomander/RandomProject/server-stuff/tracker/config/trader.env
ExecStart=/home/anomander/RandomProject/server-stuff/tracker/.venv/bin/python /home/anomander/RandomProject/server-stuff/tracker/scheduler/nightly.py
TimeoutStartSec=45min
