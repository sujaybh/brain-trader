[Unit]
Description=Thesis Trader nightly: reconcile, snapshot, news, triggers
# network for the news feeds; ollama.service is ordered only if it exists on this machine
# (local Ollama). The job itself also waits for the broker (BROKER_WAIT_S) and Ollama (OLLAMA_WAIT_S).
After=thesis-broker.service network-online.target ollama.service
Wants=thesis-broker.service network-online.target

[Service]
Type=oneshot
User=anomander
SupplementaryGroups=thesis
UMask=0002
WorkingDirectory=__ROOT__
EnvironmentFile=-__ROOT__/config/trader.env
ExecStart=__ROOT__/.venv/bin/python __ROOT__/scheduler/nightly.py
TimeoutStartSec=45min
