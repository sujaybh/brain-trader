[Unit]
Description=Thesis Trader web dashboard (over Tailscale)
After=network-online.target thesis-broker.service
Wants=network-online.target

[Service]
Type=simple
User=anomander
SupplementaryGroups=thesis
UMask=0002
WorkingDirectory=/home/anomander/RandomProject/server-stuff/tracker
EnvironmentFile=-/home/anomander/RandomProject/server-stuff/tracker/config/trader.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/anomander/RandomProject/server-stuff/tracker/.venv/bin/python -m web
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
