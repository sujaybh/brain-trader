# Non-secret settings shared by the broker, tools, scheduler and web app.
# Copy to config/trader.env. Alpaca keys go in config/alpaca.env (see alpaca.env.example).

# Shared secret between tools and the broker daemon (any random string).
BROKER_TOKEN=change-me
BROKER_HOST=127.0.0.1
BROKER_PORT=8787
# alpaca | fake   (fake = in-memory simulated broker for tests and dry runs)
BROKER_BACKEND=alpaca
# Seconds between the daemon's own fill checks during market hours (0 or off = only at ticks).
BROKER_FILL_POLL_SECONDS=60

# ntfy topic for phone pushes. Pick something unguessable, subscribe in the ntfy app.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# Web dashboard (served over Tailscale). WEB_URL is what the phone can reach.
WEB_HOST=0.0.0.0
WEB_PORT=8010
WEB_URL=http://100.64.0.19:8010
WEB_TOKEN=change-me-too

# Qwen for news digests. Primary is the 30B on the GPU box; fallback is the local 9.7B.
OLLAMA_URL=http://100.64.0.6:11434
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_FALLBACK_URL=http://127.0.0.1:11434
OLLAMA_FALLBACK_MODEL=qwen3.5:latest

# Boot/wake robustness. Scheduled jobs (tick, nightly, weekly review) wait this many seconds
# for the broker's /health before giving up with one journaled error; news.py waits this long
# for Ollama (primary or fallback) before digesting.
BROKER_WAIT_S=120
OLLAMA_WAIT_S=60

# Claude Code CLI used by dashboard chat and the weekly review (thesis-review.timer). systemd
# units have a minimal PATH; set the full path if `scheduler/doctor.py` says it is not found.
#CLAUDE_BIN=/home/you/.local/bin/claude

# Optional: HTTP Basic auth in front of the whole web app (in addition to WEB_TOKEN), e.g. when
# it sits behind Traefik. Format user:password. /healthz stays open. Empty = off.
#WEB_BASIC_AUTH=

# LLM backend for dashboard chat and reviews: claude (Claude Code CLI login; default) or ollama
# (runs against the Ollama hosts above, no Claude login; chat gets a stricter tool guard and cannot
# use order.py, trades go through propose.py and a phone tap). Per-caller overrides win.
#LLM_BACKEND=claude
#LLM_BACKEND_CHAT=ollama
#LLM_BACKEND_REVIEW=ollama
# Models for Ollama callers (default OLLAMA_MODEL); context window requested per call.
#OLLAMA_CHAT_MODEL=qwen3-coder:30b
#OLLAMA_REVIEW_MODEL=qwen3-coder:30b
#OLLAMA_NUM_CTX=16384
# Tools the Ollama chat may run (comma list; order, halt and thesis_resume are always refused).
#CHAT_TOOLS_OLLAMA=positions,journal,quote,thesis_list,thesis_show,usage,news,backtest,propose,thesis_create,thesis_pause
